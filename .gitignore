/Lib/

# Hides password
Backend\instance\config.py

# ignore all pycache files
*.pyc
*.pyo
*.pyd
*.env
__pycache__/
.pytest_cache/

# ignore virtual environment
.venv/

Lib/

# ephemeral per-session goals (recreated each session)
SESSION_PLAN.md

# Spheres extractor scratch (unpacked pf1spheres packs) + ad-hoc verification scripts +
# the harvest-workflow snapshot (transient input to merge_spheres_harvest.py)
Backend/scripts/_spheres_scratch/
Backend/scripts/_smoke_spheres.py
Backend/scripts/_verify_spheres_integration.py
Backend/scripts/_spheres_harvest_result.json

# Throwaway spell-conditional smoke harness (durable checks live in test_spell_conditionals.py)
Backend/scripts/_smoke_spell_conditionals.py

# Path of War palette generator: builder + promote-to-module script + LLM-generated maneuver/stance
# data + intermediates + the importable palette actor. Personal tooling; the durable output lives in
# the FoundryVTT module's curated maneuver_changes.json / stance_changes.json.
Backend/scripts/_pow_generator/

# Spheres conditional generator: per-sphere curated {modifiers,rider} files + worklists + promote
# script. Personal tooling; the durable output lives in the FoundryVTT module's curated
# combat_talent_conditionals.json / magic_talent_conditionals.json (and the backend passives file).
Backend/scripts/_spheres_generator/

# Class-feature / feat conditional sweep: per-pool worklist batches sliced by
# build_conditional_candidates.py. Regenerate on demand; the durable outputs are the committed
# report (docs/conditional_candidates.md) and, once authored, the curated entries in
# class_feature_effects_overrides.json / feats/feat_conditionals.json.
Backend/scripts/_conditional_candidates/

# runtime artifacts: filesystem session fallback + backstory-API usage tally
flask_session/
Backend/usage_stats.json